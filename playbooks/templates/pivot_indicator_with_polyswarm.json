{
    "name": "Pivot from an indicator with PolySwarm",
    "description": "Take a domain from a Sekoia alert and ask PolySwarm which artifacts are associated with it, then comment the result. Useful when you have infrastructure but no sample, and you want to know what has been seen touching it.",
    "tags": [
        "Alerts",
        "Enrichment",
        "Threat Intelligence"
    ],
    "nodes": {
        "0": {
            "name": "Manual Trigger",
            "type": "trigger",
            "outputs": {
                "default": [
                    "1"
                ]
            },
            "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
            "trigger_uuid": "fc26eb9f-b272-4c15-b3bf-ace397c0dc57"
        },
        "1": {
            "name": "Get Alert",
            "type": "action",
            "outputs": {
                "default": [
                    "2"
                ]
            },
            "arguments": {
                "stix": false,
                "uuid": "{{ node.0.alert_uuid }}"
            },
            "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
            "action_uuid": "8d189665-5401-4098-8d60-944de9a6199a"
        },
        "2": {
            "name": "Get Events",
            "type": "action",
            "outputs": {
                "default": [
                    "3"
                ]
            },
            "arguments": {
                "query": "alert_short_ids: \"{{ node.1.short_id }}\"",
                "latest_time": "{{ node.1.last_seen_at }}",
                "earliest_time": "{{ node.1.first_seen_at }}"
            },
            "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
            "action_uuid": "af0b4355-a428-43d6-991c-d5ff878e17d5"
        },
        "3": {
            "name": "Read JSON File",
            "type": "action",
            "outputs": {
                "default": [
                    "4"
                ]
            },
            "arguments": {
                "file": "{{ node.2| jsonpath(\"$.events[0]\", True) }}",
                "to_file": false,
                "jsonpath": "$..[\"url.domain\"]",
                "return_list": false
            },
            "module_uuid": "07cce76b-a319-40ee-a0cf-1ba433431e21",
            "action_uuid": "ecedfa52-7033-4ea8-9c3b-93ad34295f87"
        },
        "4": {
            "name": "Search IOC",
            "type": "action",
            "outputs": {
                "found": [
                    "5"
                ],
                "truncated": [
                    "6"
                ],
                "not found": [
                    "7"
                ]
            },
            "arguments": {
                "domain": "{{ node.3.output }}",
                "limit": 20
            },
            "module_uuid": "0e30189d-583b-4a61-8fe1-9fea4c329985",
            "action_uuid": "1747a064-d603-4da9-b556-a79b69964a52"
        },
        "5": {
            "name": "Comment Alert",
            "type": "action",
            "outputs": {
                "default": []
            },
            "arguments": {
                "uuid": "{{ node.0.alert_uuid }}",
                "content": "PolySwarm: {{ node.4.returned_count }} artifacts are associated with this domain."
            },
            "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
            "action_uuid": "0d323de3-a864-4afe-a0c3-e7ff45883d7a"
        },
        "6": {
            "name": "Comment Alert",
            "type": "action",
            "outputs": {
                "default": []
            },
            "arguments": {
                "uuid": "{{ node.0.alert_uuid }}",
                "content": "PolySwarm: {{ node.4.returned_count }} artifacts returned for this domain and more exist. Raise the limit to see the rest."
            },
            "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
            "action_uuid": "0d323de3-a864-4afe-a0c3-e7ff45883d7a"
        },
        "7": {
            "name": "Comment Alert",
            "type": "action",
            "outputs": {
                "default": []
            },
            "arguments": {
                "uuid": "{{ node.0.alert_uuid }}",
                "content": "PolySwarm: no artifacts are associated with this domain."
            },
            "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
            "action_uuid": "0d323de3-a864-4afe-a0c3-e7ff45883d7a"
        }
    },
    "workspace": [
        "Operation Center"
    ],
    "uuid": "c2930c3f-8502-4310-9539-8bab3ed8c2b8"
}