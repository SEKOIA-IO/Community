{
    "name": "Enrich an alert with PolySwarm",
    "description": "Look up the file hash on a Sekoia alert against the detection engines on PolySwarm and comment the verdict back onto the alert. The lookup is read only and spends no scanning quota, so it is safe to run on every alert. The unknown branch is wired separately because an artifact nobody has seen is not the same as one nobody flagged.",
    "tags": [
        "Alerts",
        "Enrichment"
    ],
    "nodes": {
        "0": {
            "name": "Manual Trigger",
            "type": "trigger",
            "outputs": {
                "default": [
                    "1"
                ]
            },
            "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
            "trigger_uuid": "fc26eb9f-b272-4c15-b3bf-ace397c0dc57"
        },
        "1": {
            "name": "Get Alert",
            "type": "action",
            "outputs": {
                "default": [
                    "2"
                ]
            },
            "arguments": {
                "stix": false,
                "uuid": "{{ node.0.alert_uuid }}"
            },
            "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
            "action_uuid": "8d189665-5401-4098-8d60-944de9a6199a"
        },
        "2": {
            "name": "Get Events",
            "type": "action",
            "outputs": {
                "default": [
                    "3"
                ]
            },
            "arguments": {
                "query": "alert_short_ids: \"{{ node.1.short_id }}\"",
                "latest_time": "{{ node.1.last_seen_at }}",
                "earliest_time": "{{ node.1.first_seen_at }}"
            },
            "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
            "action_uuid": "af0b4355-a428-43d6-991c-d5ff878e17d5"
        },
        "3": {
            "name": "Read JSON File",
            "type": "action",
            "outputs": {
                "default": [
                    "4"
                ]
            },
            "arguments": {
                "file": "{{ node.2| jsonpath(\"$.events[0]\", True) }}",
                "to_file": false,
                "jsonpath": "$..[\"file.hash.sha256\"]",
                "return_list": false
            },
            "module_uuid": "07cce76b-a319-40ee-a0cf-1ba433431e21",
            "action_uuid": "ecedfa52-7033-4ea8-9c3b-93ad34295f87"
        },
        "4": {
            "name": "Search Hash",
            "type": "action",
            "outputs": {
                "detected": [
                    "5"
                ],
                "not detected": [
                    "6"
                ],
                "unknown": [
                    "7"
                ]
            },
            "arguments": {
                "query_hash": "{{ node.3.output }}",
                "detect_threshold": 1
            },
            "module_uuid": "0e30189d-583b-4a61-8fe1-9fea4c329985",
            "action_uuid": "525cc5d7-0c94-4408-bbd5-8b26debf3dc6"
        },
        "5": {
            "name": "Comment Alert",
            "type": "action",
            "outputs": {
                "default": []
            },
            "arguments": {
                "uuid": "{{ node.0.alert_uuid }}",
                "content": "PolySwarm: detected. {{ node.4.malicious_detections }} of {{ node.4.total_detections }} engines flagged this file as malicious. Family: {{ node.4.family }}. Details: {{ node.4.permalink }}"
            },
            "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
            "action_uuid": "0d323de3-a864-4afe-a0c3-e7ff45883d7a"
        },
        "6": {
            "name": "Comment Alert",
            "type": "action",
            "outputs": {
                "default": []
            },
            "arguments": {
                "uuid": "{{ node.0.alert_uuid }}",
                "content": "PolySwarm: not detected. Engines answered and none flagged this file. {{ node.4.benign_detections }} of {{ node.4.total_detections }} called it benign. Details: {{ node.4.permalink }}"
            },
            "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
            "action_uuid": "0d323de3-a864-4afe-a0c3-e7ff45883d7a"
        },
        "7": {
            "name": "Comment Alert",
            "type": "action",
            "outputs": {
                "default": []
            },
            "arguments": {
                "uuid": "{{ node.0.alert_uuid }}",
                "content": "PolySwarm: unknown. PolySwarm has not seen this file, or a scan has not finished. This is not the same as clean, so consider a scan or a detonation."
            },
            "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
            "action_uuid": "0d323de3-a864-4afe-a0c3-e7ff45883d7a"
        }
    },
    "workspace": [
        "Operation Center"
    ],
    "uuid": "9cfb451e-0f31-452b-b94b-fb2797272724"
}