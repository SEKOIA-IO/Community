{
    "name": "Check several hashes at once with PolySwarm",
    "description": "Look up every file hash on a Sekoia alert against PolySwarm in one step. This is a loop rather than a batch, so fifty hashes cost fifty requests, and a run that stops early reports partial. Treat partial as an incomplete answer, never as a clean one for the hashes it never reached.",
    "tags": [
        "Alerts",
        "Enrichment"
    ],
    "nodes": {
        "0": {
            "name": "Manual Trigger",
            "type": "trigger",
            "outputs": {
                "default": [
                    "1"
                ]
            },
            "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
            "trigger_uuid": "fc26eb9f-b272-4c15-b3bf-ace397c0dc57"
        },
        "1": {
            "name": "Get Alert",
            "type": "action",
            "outputs": {
                "default": [
                    "2"
                ]
            },
            "arguments": {
                "stix": false,
                "uuid": "{{ node.0.alert_uuid }}"
            },
            "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
            "action_uuid": "8d189665-5401-4098-8d60-944de9a6199a"
        },
        "2": {
            "name": "Get Events",
            "type": "action",
            "outputs": {
                "default": [
                    "3"
                ]
            },
            "arguments": {
                "query": "alert_short_ids: \"{{ node.1.short_id }}\"",
                "latest_time": "{{ node.1.last_seen_at }}",
                "earliest_time": "{{ node.1.first_seen_at }}"
            },
            "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
            "action_uuid": "af0b4355-a428-43d6-991c-d5ff878e17d5"
        },
        "3": {
            "name": "Read JSON File",
            "type": "action",
            "outputs": {
                "default": [
                    "4"
                ]
            },
            "arguments": {
                "file": "{{ node.2| jsonpath(\"$.events[0]\", True) }}",
                "to_file": false,
                "jsonpath": "$..[\"file.hash.sha256\"]",
                "return_list": true
            },
            "module_uuid": "07cce76b-a319-40ee-a0cf-1ba433431e21",
            "action_uuid": "ecedfa52-7033-4ea8-9c3b-93ad34295f87"
        },
        "4": {
            "name": "Search Multiple Hashes",
            "type": "action",
            "outputs": {
                "detected": [
                    "5"
                ],
                "not detected": [
                    "6"
                ],
                "partial": [
                    "7"
                ]
            },
            "arguments": {
                "hashes": "{{ node.3.output }}",
                "include_assertions": false
            },
            "module_uuid": "0e30189d-583b-4a61-8fe1-9fea4c329985",
            "action_uuid": "274fddd5-244d-4842-992a-a2f2b032e914"
        },
        "5": {
            "name": "Comment Alert",
            "type": "action",
            "outputs": {
                "default": []
            },
            "arguments": {
                "uuid": "{{ node.0.alert_uuid }}",
                "content": "PolySwarm: at least one of these hashes is flagged. {{ node.4.queried_count }} of {{ node.4.requested_count }} looked up. Not found: {{ node.4.not_found | join(', ') or 'none' }}"
            },
            "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
            "action_uuid": "0d323de3-a864-4afe-a0c3-e7ff45883d7a"
        },
        "6": {
            "name": "Comment Alert",
            "type": "action",
            "outputs": {
                "default": []
            },
            "arguments": {
                "uuid": "{{ node.0.alert_uuid }}",
                "content": "PolySwarm: no engine flagged any of these hashes. {{ node.4.queried_count }} of {{ node.4.requested_count }} looked up. Not found: {{ node.4.not_found | join(', ') or 'none' }}"
            },
            "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
            "action_uuid": "0d323de3-a864-4afe-a0c3-e7ff45883d7a"
        },
        "7": {
            "name": "Comment Alert",
            "type": "action",
            "outputs": {
                "default": []
            },
            "arguments": {
                "uuid": "{{ node.0.alert_uuid }}",
                "content": "PolySwarm: the run stopped early and returned what it had. {{ node.4.queried_count }} of {{ node.4.requested_count }} were looked up. The rest have no answer and must not be read as clean."
            },
            "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
            "action_uuid": "0d323de3-a864-4afe-a0c3-e7ff45883d7a"
        }
    },
    "workspace": [
        "Operation Center"
    ],
    "uuid": "35939947-b020-4a52-8f15-f8abcc4cd50b"
}