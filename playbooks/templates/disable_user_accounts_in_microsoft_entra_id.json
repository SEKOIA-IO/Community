{
  "name": "Disable user accounts in Microsoft Entra ID",
  "nodes": {
    "0": {
      "name": "Manual start from an Alert",
      "type": "trigger",
      "outputs": {
        "default": [
          "1"
        ]
      },
      "position": {
        "x": 1500,
        "y": 1500
      },
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
      "trigger_uuid": "fc26eb9f-b272-4c15-b3bf-ace397c0dc57"
    },
    "1": {
      "name": "Get the Alert details",
      "type": "action",
      "outputs": {
        "default": [
          "2"
        ]
      },
      "position": {
        "x": 1500,
        "y": 1736
      },
      "arguments": {
        "stix": false,
        "uuid": "{{ node.0.alert_uuid }}"
      },
      "action_uuid": "8d189665-5401-4098-8d60-944de9a6199a",
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a"
    },
    "2": {
      "loop": [
        "3"
      ],
      "name": "Foreach Asset in the alert",
      "type": "operator",
      "items": "{{ node.1.assets }}",
      "outputs": {
        "default": []
      },
      "subtype": "foreach",
      "position": {
        "x": 1500,
        "y": 1972
      }
    },
    "3": {
      "name": "Get Asset details including connector identities",
      "type": "action",
      "outputs": {
        "default": [
          "4"
        ]
      },
      "position": {
        "x": 1500,
        "y": 2208
      },
      "arguments": {
        "uuid": "{{ node.2.default.value }}",
        "with_compliance": true
      },
      "action_uuid": "7df20273-8698-45f8-b2b4-6b6d28717b45",
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a"
    },
    "4": {
      "name": "Is an account Asset?",
      "type": "operator",
      "cases": [
        {
          "left": "{{ node.3.type }}",
          "name": "Yes",
          "right": "account",
          "comparison": "=="
        }
      ],
      "outputs": {
        "Yes": [
          "5"
        ],
        "else": []
      },
      "subtype": "condition",
      "position": {
        "x": 1500,
        "y": 2444
      }
    },
    "5": {
      "name": "Has exactly one usable Entra ID connector identity?",
      "type": "operator",
      "cases": [
        {
          "left": "{{ node.3.connectors | default([], true) | selectattr('connector_uuid', 'defined') | selectattr('connector_uuid', 'equalto', 'b6e2e2e2-4c3a-4b7a-9e2a-1f2c3d4e5f6a') | selectattr('external_id', 'defined') | selectattr('external_id') | list | length }}",
          "name": "Yes",
          "right": "1",
          "comparison": "=="
        }
      ],
      "outputs": {
        "Yes": [
          "6"
        ],
        "else": []
      },
      "subtype": "condition",
      "position": {
        "x": 1500,
        "y": 2680
      }
    },
    "6": {
      "name": "Disable Microsoft Entra ID User",
      "type": "action",
      "outputs": {
        "default": [
          "7"
        ]
      },
      "position": {
        "x": 1500,
        "y": 2916
      },
      "arguments": {
        "userPrincipalName": "{{ node.3.connectors | default([], true) | selectattr('connector_uuid', 'defined') | selectattr('connector_uuid', 'equalto', 'b6e2e2e2-4c3a-4b7a-9e2a-1f2c3d4e5f6a') | selectattr('external_id', 'defined') | selectattr('external_id') | map(attribute='external_id') | first }}"
      },
      "action_uuid": "df34b4c8-f570-5c70-a986-e1c649aedf42",
      "module_uuid": "3abf7928-65ef-4a5f-ba3e-5fbe56123d0c"
    },
    "7": {
      "name": "Comment Alert",
      "type": "action",
      "outputs": {
        "default": []
      },
      "position": {
        "x": 1500,
        "y": 3152
      },
      "arguments": {
        "uuid": "{{ node.0.alert_uuid }}",
        "content": "User {{ node.3.name }} has been disabled in Microsoft Entra ID."
      },
      "action_uuid": "0d323de3-a864-4afe-a0c3-e7ff45883d7a",
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a"
    }
  },
  "description": "Manually disable Microsoft Entra ID accounts associated with an alert and comment on the alert after success. Requires Sekoia Reveal, a configured Microsoft Entra ID asset connector, and a Microsoft Entra ID action account with permissions to disable users.",
  "tags": [
    "alerts",
    "assets",
    "microsoft entra id",
    "remediation"
  ],
  "workspace": "Operation Center"
}
